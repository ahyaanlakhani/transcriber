# Get a free key at https://console.groq.com/keys and paste it after the = sign.
GROQ_API_KEY=

# Optional:
# TRANSCRIBER_DATA_DIR=C:\path\to\recordings-folder
# TRANSCRIBER_PORT=8000

# AI notes. Writer: open-source gpt-oss-120b on Groq (uses GROQ_API_KEY above).
# Checker: Gemini free tier (free key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# NOTES_WRITER=cerebras:gpt-oss-120b
# NOTES_CHECKER=gemini:gemini-3.8-flash   (or "none")

# Your own transcription server, for speaker labels (see server/README.md). Leave empty if you don't have one.
# TRANSCRIBE_SERVER_URL=http://192.168.1.20:8765
# Transcribe Local-only recordings on this laptop (optional; slow without a graphics card; see docs/offline.md):
# LOCAL_TRANSCRIBER=small
# TRANSCRIBE_SERVER_TOKEN=

# Your own language. The language menu starts with English, Auto-detect and "English + your other language (mixed)".
# Add more with EXTRA_LANGUAGES (code:Name pairs; the code is the two- or three-letter one Whisper uses: es, fr, de, hi,
# ar, ur, ...), and name the other language of mixed lectures with SECOND_LANGUAGE.
# EXTRA_LANGUAGES=es:Spanish,fr:French
# SECOND_LANGUAGE=Spanish

# Phone link: your laptop's Tailscale name, so the app answers to it (see docs/phone-setup.md). Leave empty otherwise.
# TRANSCRIBER_ALLOWED_HOSTS=my-laptop.tail1234.ts.net
