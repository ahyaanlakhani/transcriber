# Copy this file to .env and fill it in.

# Any long random text. Put the SAME value in TRANSCRIBE_SERVER_TOKEN in the laptop app's .env.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TRANSCRIBE_SERVER_TOKEN=

# HuggingFace read token, for speaker labels (see README.md). Leave empty to transcribe without speakers.
HF_TOKEN=

# Optional
# WHISPER_MODEL=large-v3
# PORT=8765
